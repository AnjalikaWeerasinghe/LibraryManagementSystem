@using Library.Models
@using Library.Utilities
@model PagedResult<Library.ViewModels.ApplicationUserViewModel>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h4 class="mb-3">Application Users (@Model.TotalItems)</h4>

<form asp-action="Index" method="get">
    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" style="width: 400px" placeholder="Search by User Name" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-primary">Clear</a>
</form>

<p><a asp-action="Create" class="btn btn-primary">
    <i class="bi bi-plus-circle me-1"></i>Create a New User
    </a>
</p>

<table class="table table-hover table-sm align-middle">
    <thead class="table-light">
        <tr>
            <th>User Code</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th style="width:140px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Data)
        {
            <tr>
                <td>@u.UserCode</td>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@u.UserRole</td>
                <td>
                    <span class="badge bg-@(u.UserStatus == UserStatus.Active ? "success" : "secondary")">
                        @u.UserStatus
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-dark">
                       Edit 
                    </a>


                    <form asp-action="ToggleStatus" asp-route-id="@u.Id"
                          method="post" class="d-inline">
                        <button type="submit"
                                class="btn btn-sm @(u.UserStatus==UserStatus.Active?"btn-warning":"btn-success")"
                                title="Toggle Active / Inactive">
                            <i class="bi @(u.UserStatus==UserStatus.Active?"bi-slash-circle":"bi-check-circle")"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<cs-pager cs-paging-pagesize=(int)Model.PageSize
          cs-paging-pagenumber=(int)Model.PageNumber
          cs-paging-totalitems=(int)Model.TotalItems
          cs-pagenumber-param="pageNumber"
          asp-controller="User"

          asp-action="Index"
          cs-pager-li-current-class="page-item active"
          cs-pager-li-other-class="page-item"
          cs-pager-li-non-active-class="page-item disabled"
          cs-pager-link-current-class="page-link"
          cs-pager-link-other-class="page-link">
</cs-pager>
