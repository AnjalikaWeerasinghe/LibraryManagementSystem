@using Library.Utilities
@model PagedResult<Library.ViewModels.ApplicationUserViewModel>

@{
    ViewData["Title"] = "AllMembers";
}

<h1>Library Member Details</h1>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>
                FullName
            </th>
            <th>
                Calling Name
            </th>
            
            <th>
                UserCode
            </th>
            <th>
                Gender
            </th>
           
            <th>
                Address
            </th>
            <th>
                DOB
            </th>
            <th>
                User Status
            </th>
            <th>
                Picture Url
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Data) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CallingName)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.UserCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender)
            </td>           
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DOB)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PictureUrl)
            </td>
            
            <td>
                <div d-flex gap-2>
                    <a asp-action="Edit" asp-route-id="@item.UserCode" class="btn btn-dark btn-sm">Edit</a>
                    <button class="btn btn-danger btn-sm" onclick="openDeleteModal(@item.UserCode, '@item.CallingName')">Delete</button>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>

<cs-pager cs-paging-pagesize=(int)Model.PageSize
          cs-paging-pagenumber=(int)Model.PageNumber
          cs-paging-totalitems=(int)Model.TotalItems
          cs-pagenumber-param="pageNumber"
          asp-controller="User"
          asp-action="Index"
          cs-pager-li-current-class="page-item active"
          cs-pager-li-other-class="page-item"
          cs-pager-li-non-active-class="page-item disabled"
          cs-pager-link-current-class="page-link"
          cs-pager-link-other-class="page-link">
</cs-pager>
