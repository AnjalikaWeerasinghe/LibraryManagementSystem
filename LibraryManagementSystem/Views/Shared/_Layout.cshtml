<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-info border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="mx-auto d-block" src="~/Images/Urban_Council_Gampola_Logo.png" height="40"/>
                    <h6 class="mt-2">Public Library <br/> Gampola</h6>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-area="" asp-controller="About" asp-action="Index">About Us</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-area="" asp-controller="OurService" asp-action="Index">Our Services</a>
                        </li>

                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-area="member" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-area="member" asp-controller="Event" asp-action="Index">Library Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-area="member" asp-controller="MyProfile" asp-action="Index">My Profile</a>
                            </li>
                        }


                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown hover-dropdown">
                                <a class="nav-link dropdown-toggle text-dark me-5 no-caret" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Collections</a>
                                <ul class="dropdown-menu" aria-labelledby="collectiondropdown">
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Book" asp-action="Index">Books</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Newspaper" asp-action="Index">Newspapers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Journal" asp-action="Index">Journals</a></li>
                                    <li><a class="dropdown-item" asp-controller="Periodical" asp-action="Index">Periodicals</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-4" asp-area="admin" asp-controller="Event" asp-action="Index">Events</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-4" asp-area="admin" asp-controller="Report" asp-action="Index">Reports</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-4" asp-area="admin" asp-controller="Acquisition" asp-action="Index">Acquisitions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-4" asp-area="admin" asp-controller="User" asp-action="AllMembers">Member Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark me-4" asp-area="admin" asp-controller="User" asp-action="Index">User Details</a>
                            </li>
                            <li class="nav-item dropdown hover-dropdown">
                                <a class="nav-link dropdown-toggle text-dark me-5 no-caret" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin Settings</a>
                                <ul class="dropdown-menu" aria-labelledby="collectiondropdown">
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Library" asp-action="Index">Library Information</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Language" asp-action="Index">Languages of Catalogs</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Category" asp-action="Index">Catagories of Catalogs</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Publisher" asp-action="Index">Publishers</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Genre" asp-action="Index">Genres of Books</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Country" asp-action="Index">Countries</a></li>
                                    <li><a class="dropdown-item" asp-area="admin" asp-controller="Author" asp-action="Index">Authors</a></li>
                                </ul>
                            </li>

                        }

                        
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        
                    </ul>
                    <partial name="_LoginPartial"/>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - LibraryManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
