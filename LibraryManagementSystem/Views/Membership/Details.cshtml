@{
    ViewData["Title"] = "Membership Details";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="card-title mb-4 text-primary">📚 Library Membership Process</h2>
            <p class="card-text">
                Here is the detailed information about how to join the library, benefits, and terms.
            </p>

            <hr class="my-4" />

            <h5 class="text-secondary">📄 Needed Documents</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">Completed Membership Form</li>
            </ul>

            <h5 class="text-secondary">⏱️ Time to Complete the Process</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">1 Day</li>
            </ul>

            <h5 class="text-secondary">📞 Direct Contact</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">Front Office - 081-2352275</li>
            </ul>

            <h5 class="text-secondary">👥 For Further Information</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">Secretary</li>
                <li class="list-group-item">Librarian</li>
                <li class="list-group-item">Library Assistants</li>
            </ul>

            <h5 class="text-secondary">💰 Relevant Costs</h5>

            <ul class="list-group mb-4">
                <li class="list-group-item">Membership Form - Rs. 20.00</li>
            </ul>

            <div class="mb-4">
                <h6 class="text-dark">🏠 Within the area of Urban Council (Elderly)</h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Membership Cost - Rs. 150.00</li>
                    <li class="list-group-item">Security Deposit - Rs. 200.00</li>
                    <li class="list-group-item">Service Cost - Rs. 200.00</li>
                </ul>
            </div>

            <div class="mb-4">
                <h6 class="text-dark">📍 Within 10 km of Urban Council (Elderly)</h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Membership Cost - Rs. 200.00</li>
                    <li class="list-group-item">Security Deposit - Rs. 300.00</li>
                    <li class="list-group-item">Service Cost - Rs. 200.00</li>
                </ul>
            </div>

            <div class="mb-4">
                <h6 class="text-dark">👧 Within the area of Urban Council (Children)</h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Membership Cost - Rs. 100.00</li>
                    <li class="list-group-item">Security Deposit - Rs. 100.00</li>
                    <li class="list-group-item">Service Cost - Rs. 100.00</li>
                </ul>
            </div>

            <div class="mb-3">
                <h6 class="text-dark">👦 Within 10 km of Urban Council (Children)</h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Membership Cost - Rs. 150.00</li>
                </ul>
            </div>
        </div>
    </div>
</div>
